PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/medicontrol.db

# Contexto DEMO: inyección directa de contexto para pruebas/demostración
# local, SEPARADA de la autenticación real (ver README, sección
# "Seguridad y modo DEMO"). Se fuerza a false en NODE_ENV=production sin
# importar este valor.
DEMO_MODE=true

# Firma las cookies de sesión (express-session). OBLIGATORIA en
# producción (el arranque falla si falta); genera un valor propio con
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Nunca reutilices el valor de ejemplo de este archivo.
SESSION_SECRET=replace-this-with-a-random-64-char-hex-string

# Duración de la sesión en milisegundos (por defecto 30 minutos).
SESSION_TTL_MS=1800000

# Contraseña usada por `npm run seed:demo` para TODOS los usuarios
# ficticios que crea (ver README, sección "Usuarios ficticios de
# demostración"). Defínela solo en tu .env local; nunca la commitees.
DEMO_USERS_PASSWORD=
